---
import Footer from '@components/chrome/Footer.astro';
import Header from '@components/chrome/Header.astro';
import Hero from '@components/sections/hero/Hero.astro';
import Marquee from '@components/sections/marquee/Marquee.astro';
import { basic, marquee } from '@data/data.json';
import Layout from '@layouts/Layout.astro';

const { name } = basic;
---

<Layout title={name}>
  <Header />
  <main class="flex flex-1 flex-col gap-12">
    <Hero />
    <Marquee items={marquee} />
  </main>
  <Footer />
</Layout>
