---
interface Props {
  phrases: string[];
  class?: string;
}

const { phrases, class: className } = Astro.props;
---

<aside class:list={[className, 'flex w-full gap-20 overflow-hidden py-4 hover:[&>ul]:[animation-play-state:paused]']}>
  {Array.from({ length: 3 }).map((_, index) => (
    <ul class="flex animate-marquee gap-20" aria-hidden={index > 0 ? 'true' : undefined}>
      {phrases.map((phrase) => (
        <li class="text-8xl flex gap-4 font-semibold whitespace-nowrap uppercase">
          <span>{phrase}</span>
          <div class="relative h-10 w-10 rounded-full border before:absolute before:top-1/2 before:left-1/2 before:h-px before:w-3/4 before:-translate-x-1/2 before:-translate-y-1/2 before:bg-neutral-950 after:absolute after:top-1/2 after:left-1/2 after:h-px after:w-3/4 after:-translate-x-1/2 after:-translate-y-1/2 after:rotate-90 after:bg-neutral-950" />
        </li>
      ))}
    </ul>
  ))}
</aside>
