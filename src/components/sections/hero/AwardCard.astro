---
interface Props {
  index: string;
  name: string;
  date: string;
  description: string;
}

const { index, name, date, description } = Astro.props as Props;
---

<article
  class="bg-brown-200 bg-opacity-0 flex flex-wrap justify-between gap-4 rounded-md rounded-t-3xl border bg-clip-padding p-10 shadow-sm backdrop-blur-md backdrop-filter"
>
  <div class="flex flex-1 gap-4">
    <span class="text-size-xlarge">{index.padStart(2, '0')}</span>
    <div class="flex flex-col">
      <time class="opacity-80">{date}</time>
      <h2 class="text-size-large">{name}</h2>
    </div>
  </div>
  <p class="max-w-[50ch] font-light">{description}</p>
</article>
