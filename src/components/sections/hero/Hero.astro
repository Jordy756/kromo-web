---
import Link from '@components/ui/Link.astro';
import data from '@data/data.json';
import AwardCard from './AwardCard.astro';

const { basic, awards } = data;
const { name, summary } = basic;
---

<section class="relative flex min-h-screen flex-col justify-between gap-12 overflow-hidden p-10 pb-0">
  <article class="mt-22 flex w-[min(var(--max-width),100%)] flex-1 flex-col items-start justify-center self-center">
    <h1 class="text-6xl font-semibold uppercase">{name}</h1>
    <p class="max-w-[50ch] mt-2 mb-4">{summary}</p>
    <Link href="/authorization">Comenzar</Link>
  </article>
  <section class="flex flex-col gap-4">
    {awards.map(({ name, date, description }, index) => (
      <AwardCard index={index + 1 + ''} name={name} date={date} description={description} />
    ))}
  </section>
  <video
    src="/videos/hero.mp4"
    poster="/images/hero_poster.png"
    autoplay
    muted
    loop
    class="cover absolute inset-0 -z-1 size-full"
  ></video>
</section>
