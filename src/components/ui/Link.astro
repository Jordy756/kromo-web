---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'btn-primary' | 'btn-secondary';
}

const { variant = 'btn-primary', class: className, ...rest } = Astro.props;
---

<a class:list={[className, 'flex items-center justify-center gap-2 rounded-sm border px-6 py-3', variant]} {...rest}>
  <slot />
</a>
