---
import CloseIcon from '@components/icons/CloseIcon.astro';
import { Image } from 'astro:assets';
import { basic } from '@data/data.json';

const { logo } = basic;

const navigationLinks = [
  { label: 'Home', path: '/#home' },
  { label: 'Sobre nosotros', path: '/#about-us' },
  { label: 'Servicios', path: '/#services' },
  { label: 'Médicos', path: '/#our-team' },
];

const socialNetworks = [
  {
    name: 'Github',
    url: 'https://github.com/Jordy756',
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/yordicastro',
  },
  {
    name: 'Portafolio',
    url: 'https://jordy756-minimalist-portfolio.vercel.app',
  },
];
---

<nav class="flex items-center gap-8">
  <a href="/#" class="flex">
    <Image src={logo} width={100} height={32} class="h-8 w-auto object-contain" alt="Logo de Kromo" />
  </a>
  <button class="flex cursor-pointer items-center gap-4" popovertarget="menu">
    <div class="flex w-10 flex-col items-end justify-center gap-2">
      <span class="block h-0.5 w-full bg-neutral-950"></span>
      <span class="block h-0.5 w-[70%] bg-neutral-950"></span>
    </div>
    <span>Menu</span>
  </button>
</nav>
<div
  id="menu"
  popover
  class="fixed top-0 left-0 h-full w-full -translate-x-full p-10 transition-[translate,display,overlay,opacity] transition-discrete duration-500 ease-in-out open:translate-x-0 starting:open:-translate-x-full"
>
  <nav class="flex h-full flex-col justify-between">
    <div class="flex items-center justify-between gap-8">
      <span class="realtive -rotate-90 uppercase after:absolute after:right-[calc(100%+8px)] after:bottom-1/2 after:h-px after:w-[50vh] after:-translate-y-1/2 after:bg-neutral-950">
        Menu
      </span>
      <button class="flex cursor-pointer" popovertarget="menu" popovertargetaction="hide">
        <CloseIcon width={48} />
      </button>
    </div>
    <ul class="flex w-[min(1100px,100%)] flex-col gap-8 self-center">
      {navigationLinks.map(({ label, path }, index) => (
        <li class="relative flex items-center gap-4 border-b border-neutral-200 before:absolute before:bottom-0 before:left-0 before:h-px before:w-0 before:bg-neutral-950 before:transition-[width] before:duration-300 hover:before:w-full">
          <span class="text-size-small min-w-7 font-light">{(index + 1 + '').padStart(2, '0')}</span>
          <a href={path} class="text-size-huge font-semibold uppercase">
            {label}
          </a>
        </li>
      ))}
    </ul>
    <aside class="flex justify-between gap-8">
      <ul class="flex flex-1 gap-4">
        <li>
          <a href={'/a'} class="border-b">
            Comenzar
          </a>
        </li>
      </ul>
      <div class="h-px w-10 bg-neutral-950"></div>
      <ul class="flex flex-1 justify-end gap-4">
        {socialNetworks.map(({ name, url }) => (
          <li>
            <a href={url} target="_blank" rel="noopener noreferrer" class="border-b">
              {name}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </nav>
</div>
