---
import CloseIcon from "@components/icons/Close.astro";
import { Image } from "astro:assets";
import { basic } from "@data/data.json";

const { logo } = basic;

const navbarNavigation = [
  { label: "Home", path: "/#home" },
  { label: "Sobre nosotros", path: "/#about-us" },
  { label: "Servicios", path: "/#services" },
  { label: "Médicos", path: "/#our-team" },
];

const socialNetworks = [
  {
    name: "Github",
    url: "https://github.com/Jordy756",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/yordicastro",
  },
  {
    name: "Portafolio",
    url: "https://jordy756-minimalist-portfolio.vercel.app",
  },
];
---

<header class="fixed top-10 left-10 right-10 z-10">
  <nav class="flex items-center gap-10">
    <a href="/#" class="flex">
      <Image src={logo} width={100} height={32} class="w-full h-8 object-contain" alt="Logo de SilkTree" />
    </a>
    <button class="flex items-center gap-4 cursor-pointer" popovertarget="menu">
      <div class="w-10 flex flex-col justify-center items-end gap-2">
        <span class="block w-full h-0.5 bg-neutral-950"></span>
        <span class="block w-[70%] h-0.5 bg-neutral-950"></span>
      </div>
      <span>Menu</span>
    </button>
  </nav>

  <div
    id="menu"
    popover="auto"
    class="fixed top-0 left-0 w-full h-full p-10 -translate-x-full open:translate-x-0 transition-[translate,display,overlay,opacity] transition-discrete duration-500 ease-in-out starting:open:-translate-x-full"
  >
    <nav class="flex flex-col justify-between h-full">
      <div class="flex items-center justify-between gap-8">
        <span
          class="realtive -rotate-90 after:absolute after:bottom-1/2 after:right-[calc(100%+8px)] after:h-px after:w-[50vh] after:bg-neutral-950 after:-translate-y-1/2 uppercase"
        >
          Menu
        </span>
        <button class="flex cursor-pointer" popovertarget="menu" popovertargetaction="hide">
          <CloseIcon width={48} />
        </button>
      </div>
      <ul class="w-[min(1100px,100%)] flex flex-col gap-8 self-center">
        {
          navbarNavigation.map(({ label, path }, index) => (
            <li class="relative flex items-center gap-4 border-b border-neutral-200 before:absolute before:left-0 before:bottom-0 before:h-px before:w-0 before:bg-neutral-950 before:transition-[width] before:duration-300 hover:before:w-full">
              <span class="min-w-7 text-size-small font-light">{(index + 1 + "").padStart(2, "0")}</span>
              <a href={path} class="font-semibold text-size-huge uppercase">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <aside class="flex justify-between gap-8">
        <ul class="flex-1 flex gap-4">
          <li>
            <a href={"/a"} class="border-b">Comenzar</a>
          </li>
        </ul>
        <div class="w-10 h-px bg-neutral-950"></div>
        <ul class="flex-1 flex justify-end gap-4">
          {
            socialNetworks.map(({ name, url }) => (
              <li>
                <a href={url} target="_blank" rel="noopener noreferrer" class="border-b">
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </nav>
  </div>
</header>
